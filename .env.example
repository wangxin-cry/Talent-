# ============================================================
# TalentMatch 环境变量模板
# 用法：复制为 .env 后按需修改；.env 已被 .gitignore 忽略
#   PowerShell: Copy-Item .env.example .env
# ============================================================

# ---------------- 应用 ----------------
APP_NAME=TalentMatch
APP_ENV=dev
DEBUG=true
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------- 安全 ----------------
# 生产环境必须替换为随机长字符串
SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# 可选：独立的加密密钥（不填则从 SECRET_KEY 派生）
CONFIG_SECRET=

# ---------------- 数据库 ----------------
# 方案A（默认，无需装库）：SQLite
# 不设置 DATABASE_URL 时，后端使用项目根 data/talentmatch.db（绝对路径，最稳）
# DATABASE_URL=sqlite+aiosqlite:///./data/talentmatch.db
# 方案B（docker compose 起 PG 后使用）：PostgreSQL
# DATABASE_URL=postgresql+asyncpg://talentmatch:talentmatch@127.0.0.1:5432/talentmatch
DB_ECHO=false

# PostgreSQL（docker-compose.yml 使用）
POSTGRES_USER=talentmatch
POSTGRES_PASSWORD=talentmatch
POSTGRES_DB=talentmatch
POSTGRES_PORT=5432

# ---------------- 对象存储（MinIO） ----------------
# local：本地磁盘降级（开发最省事）
# minio：对象存储（需先 docker compose up -d）
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./data/uploads

MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=talentmatch
MINIO_SECRET_KEY=talentmatch123
MINIO_BUCKET=talentmatch-resume
MINIO_SECURE=false
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
PRESIGN_EXPIRE_SECONDS=600

# ---------------- 邮件（注册验证 / 找回密码） ----------------
# EMAIL_HOST 为空 = 开发模式：注册直接标记已验证，重置链接只写后端日志
# 启用真实发信示例（QQ 邮箱）：EMAIL_HOST=smtp.qq.com / EMAIL_PORT=465 / EMAIL_USE_SSL=true
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_USE_TLS=false
EMAIL_USE_SSL=true
# 发件地址必须等于登录账号（QQ 邮箱会校验），留空则回落到 EMAIL_USERNAME
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=TalentMatch
EMAIL_VERIFY_EXPIRE_HOURS=24
RESET_TOKEN_EXPIRE_MINUTES=30
FRONTEND_BASE_URL=http://localhost:5173

# ---------------- 上传限制 ----------------
MAX_UPLOAD_MB=20
ALLOWED_UPLOAD_EXTS=.pdf,.doc,.docx,.jpg,.jpeg,.png

# ---------------- LLM ----------------
# 没有 Key 时保持 LLM_MOCK=true，全链路仍可跑通
LLM_PROVIDER=zhipu
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=
LLM_CHAT_MODEL=glm-4-flash
LLM_EMBEDDING_MODEL=embedding-3
LLM_MOCK=true
LLM_TIMEOUT_SECONDS=60

# ---------------- 成本 ----------------
MONTHLY_BUDGET_CNY=500
